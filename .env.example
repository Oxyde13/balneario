# Copiar para .env.local e preencher com os dados do projeto Supabase.
# Apenas variáveis VITE_* ficam disponíveis no browser — nunca pôr aqui a service_role key.

# Project URL e anon/public key (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Emails das duas contas fixas (a password de cada uma é o PIN de 6 dígitos).
# Não aparecem na interface: o ecrã de login só mostra "Equipa" / "Administrador".
VITE_ADMIN_EMAIL=admin@balneario.app
VITE_TEAM_EMAIL=equipa@balneario.app

# URL público da app (entra no fim das mensagens do WhatsApp)
VITE_APP_URL=https://balneario-1-de-maio.pages.dev
